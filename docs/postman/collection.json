{
  "info": {
    "name": "Maintenance API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Коллекция запросов сервиса учёта заявок на обслуживание оборудования. Использует переменную {{baseUrl}} и переносит идентификаторы созданных сущностей через коллекционные переменные."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "equipmentId", "value": "" },
    { "key": "requestId", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Проверка доступности",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has status ok', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('ok'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": []
        },
        {
          "name": "Превышение лимита частоты (429)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 429 или 200', () => pm.expect([200, 429]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Equipment",
      "item": [
        {
          "name": "Создать оборудование",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('body has data.id', () => { const body = pm.response.json(); pm.expect(body.data.id).to.be.a('string'); pm.collectionVariables.set('equipmentId', body.data.id); });",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.include(pm.collectionVariables.get('equipmentId')));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина A1\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"installedAt\": \"2025-01-15T00:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "response": []
        },
        {
          "name": "Список оборудования",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data and meta', () => { const body = pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?type=turbine&sort=name&order=asc&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [
                { "key": "type", "value": "turbine" },
                { "key": "sort", "value": "name" },
                { "key": "order", "value": "asc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Карточка оборудования",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data.id', () => pm.expect(pm.response.json().data.id).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "{{equipmentId}}"] }
          },
          "response": []
        },
        {
          "name": "Обновить оборудование",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status updated', () => pm.expect(pm.response.json().data.status).to.eql('maintenance'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"maintenance\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "{{equipmentId}}"] }
          },
          "response": []
        },
        {
          "name": "Заявки по оборудованию",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data and meta', () => { const body = pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}/requests", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "{{equipmentId}}", "requests"] }
          },
          "response": []
        },
        {
          "name": "Прогноз погоды",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200 или 503', () => pm.expect([200, 503]).to.include(pm.response.code));",
                  "pm.test('body has suitable flag', () => { const body = pm.response.json(); if (pm.response.code === 200) pm.expect(body.data).to.have.property('suitable'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}/weather", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "{{equipmentId}}", "weather"] }
          },
          "response": []
        },
        {
          "name": "Дубль серийного номера (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Турбина A2\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 55.75, \"lon\": 37.61 },\n  \"installedAt\": \"2025-01-15T00:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "response": []
        },
        {
          "name": "Некорректное тело (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('has details', () => pm.expect(pm.response.json().error.details).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"name\": \"X\", \"type\": \"alien\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/equipment", "host": ["{{baseUrl}}"], "path": ["api", "equipment"] }
          },
          "response": []
        },
        {
          "name": "Несуществующий id (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment/00000000-0000-4000-8000-000000000000", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "00000000-0000-4000-8000-000000000000"] }
          },
          "response": []
        },
        {
          "name": "Удалить оборудование",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204 или 409', () => pm.expect([204, 409]).to.include(pm.response.code));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/equipment/{{equipmentId}}", "host": ["{{baseUrl}}"], "path": ["api", "equipment", "{{equipmentId}}"] }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Requests",
      "item": [
        {
          "name": "Создать заявку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "pm.test('status defaults to new', () => { const body = pm.response.json(); pm.expect(body.data.status).to.eql('new'); pm.collectionVariables.set('requestId', body.data.id); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"equipmentId\": \"{{equipmentId}}\",\n  \"title\": \"Замена лопасти\",\n  \"description\": \"Осмотр и замена\",\n  \"priority\": \"high\",\n  \"plannedAt\": \"2026-09-25T10:00:00.000Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "response": []
        },
        {
          "name": "Список заявок",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data and meta', () => { const body = pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.have.all.keys('total', 'page', 'limit'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/requests?status=new&sort=createdAt&order=desc&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"],
              "query": [
                { "key": "status", "value": "new" },
                { "key": "sort", "value": "createdAt" },
                { "key": "order", "value": "desc" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Карточка заявки",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('body has data.id', () => pm.expect(pm.response.json().data.id).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}"] }
          },
          "response": []
        },
        {
          "name": "Редактировать заявку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('priority updated', () => pm.expect(pm.response.json().data.priority).to.eql('critical'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"priority\": \"critical\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}"] }
          },
          "response": []
        },
        {
          "name": "Сменить статус (валидный)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('status in_progress', () => pm.expect(pm.response.json().data.status).to.eql('in_progress'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"in_progress\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          },
          "response": []
        },
        {
          "name": "Недопустимый переход (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 409', () => pm.response.to.have.status(409));",
                  "pm.test('code CONFLICT', () => pm.expect(pm.response.json().error.code).to.eql('CONFLICT'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"status\": \"done\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          },
          "response": []
        },
        {
          "name": "Заявка на несуществующее оборудование (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 404', () => pm.response.to.have.status(404));",
                  "pm.test('code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.eql('NOT_FOUND'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"equipmentId\": \"00000000-0000-4000-8000-000000000000\",\n  \"title\": \"Заявка на несуществующее\",\n  \"priority\": \"low\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "response": []
        },
        {
          "name": "Некорректное тело (422)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 422', () => pm.response.to.have.status(422));",
                  "pm.test('has details', () => pm.expect(pm.response.json().error.details).to.be.an('array'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"title\": \"X\", \"priority\": \"urgent\" }", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "response": []
        },
        {
          "name": "Удалить заявку",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 204', () => pm.response.to.have.status(204));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}"] }
          },
          "response": []
        }
      ]
    }
  ]
}
