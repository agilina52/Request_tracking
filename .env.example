# Порт HTTP-сервера
PORT=3000

# Режим запуска: development | production | test
NODE_ENV=development

# Разрешённые источники CORS (через запятую)
CORS_ORIGINS=http://localhost:3000

# Лимиты частоты запросов
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Внешний погодный API (Open-Meteo)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# Таймаут HTTP-запроса к погодному API, мс
REQUEST_TIMEOUT_MS=5000

# Пороги пригодности окна для наружных работ
WEATHER_MAX_WIND_MS=15
WEATHER_MAX_PRECIPITATION_MM=0

# Лимит размера тела запроса
BODY_LIMIT=100kb

# API-ключ для изменяющих операций (POST/PATCH/DELETE), заголовок X-API-Key
API_KEY=change-me
